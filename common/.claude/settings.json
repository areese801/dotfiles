{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(ls -la *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(alias *)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(sed *)",
      "Bash(source *activate*)",
      "Bash(deactivate*)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(kb version)",
      "Bash(kb --version)",
      "Bash(kb audit *)",
      "Bash(kb workspace list*)",
      "Bash(kb workspace show *)",
      "Bash(kb workspace current*)",
      "Bash(kb story list*)",
      "Bash(kb story show *)",
      "Bash(kb epic list*)",
      "Bash(kb epic show *)",
      "Bash(kb tag list*)",
      "Bash(kb token list*)",
      "Bash(kb story create *)",
      "Bash(kb story move *)",
      "Bash(kb story edit *)",
      "Bash(kb story comment *)",
      "Bash(kb story link *)",
      "Bash(kb workspace create *)",
      "Bash(kb workspace use *)",
      "Bash(kb epic create *)",
      "Bash(kb epic close *)",
      "Bash(kb epic reopen *)",
      "Bash(kb tag create *)",
      "Bash(kb tag rename *)",
      "Bash(kb backup*)",
      "Bash(kb export *)",
      "Bash(kb project init*)",
      "Bash(kb token revoke *)",
      "Bash(tc list*)",
      "Bash(tc exists *)",
      "Bash(tc outbox *)",
      "Bash(tc diff *)",
      "Bash(tc logs *)",
      "Bash(tc diagnose *)",
      "Bash(tc patch *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/scripts/claude_notify.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/scripts/claude_hook_pre_commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/scripts/claude_hook_stow_check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/scripts/claude_hook_stow_check.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "trusty-cage@trusty-cage-plugin": true
  },
  "extraKnownMarketplaces": {
    "trusty-cage-plugin": {
      "source": {
        "source": "github",
        "repo": "areese801/trusty-cage-plugin"
      }
    }
  }
}
